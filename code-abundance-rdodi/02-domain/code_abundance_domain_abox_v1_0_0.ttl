cai:TheCostPerAcceptedChangeUnit a ca:CostPerAcceptedChange, owl:NamedIndividual ;
    rdfs:label "The cost-per-accepted-change unit as defined by Staples (2026)"@en ;
    skos:definition "Bundles generation, environment setup, context, verification, review, remediation and governance into one measurable unit; the article's proposed replacement for cost-per-line-of-code."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:TheSixtyYearCodeConstraint a ca:CodeIsPreciousConstraint, owl:NamedIndividual ;
    rdfs:label "The sixty-year 'code is precious' constraint"@en ;
    skos:definition "The historical organizing constraint of software engineering that the article argues AI is now breaking."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:GitLabDuoAgentPlatformPillarInstance a ca:AgentPlatformPillar, owl:NamedIndividual ;
    rdfs:label "GitLab Duo Agent Platform as the Agent Platform pillar"@en ;
    skos:definition "GitLab's concrete instantiation of the Agent Platform pillar: create, customize and operate owned agents on chosen models and infrastructure."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:NextGenSourceControlPillarInstance a ca:ExecutionPillar, owl:NamedIndividual ;
    rdfs:label "GitLab's next-generation source control as the Execution pillar"@en ;
    skos:definition "Server-side access patterns letting an agent retrieve only what a task requires; reported up to 50x faster task execution in internal testing."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:GitLabOrbitPillarInstance a ca:ContextPillar, owl:NamedIndividual ;
    rdfs:label "GitLab Orbit as the Context pillar"@en ;
    skos:definition "A context graph connecting code, work items, pipelines, deployments and production signals across the software lifecycle, queryable by both GitLab's and third-party agents."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:GovernanceForAgentsPillarInstance a ca:GovernancePillar, owl:NamedIndividual ;
    rdfs:label "GitLab's Governance for Agents as the Governance pillar"@en ;
    skos:definition "Applies identity, policy, approval and audit controls around agent actions so organizations can increase autonomy without giving up evidence or accountability."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:UndocumentedLegacySystemsInstance a ca:HumanControlledLegacyMode, owl:NamedIndividual ;
    rdfs:label "Systems with undocumented dependencies and operational knowledge residing in people"@en ;
    skos:definition "The article's example of Mode 1: legacy systems remaining largely human-controlled until retired or rewritten."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:MostEnterpriseDevelopmentTodayInstance a ca:AgenticallyAcceleratedMode, owl:NamedIndividual ;
    rdfs:label "Most enterprise development today, per the article"@en ;
    skos:definition "The article's claim that Mode 2 is where most enterprise development currently sits, and where it expects most near-term economic value."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:StripeMinionsAsAutonomousInstance a ca:AutonomousMode, owl:NamedIndividual ;
    rdfs:label "Stripe's minions as a Mode 3 example"@en ;
    skos:definition "Agents that write pull requests end-to-end with humans reviewing rather than authoring, exemplifying agents operating the implementation loop while humans provide oversight."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:StripeMinionsPart1_2026"@en .

cai:AmplitudeNonEngineersAsBuildersInstance a ca:BuilderRole, owl:NamedIndividual ;
    rdfs:label "Amplitude's non-engineer PR authors as Builders"@en ;
    skos:definition "Designers, product managers and marketers at Amplitude who began producing code changes themselves, going from roughly zero to about five percent of pull requests."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:CursorAmplitudeCaseStudy2026"@en .

cai:GitLabPDLCProposalInstance a ca:ProductDevelopmentLifecycle, owl:NamedIndividual ;
    rdfs:label "GitLab's proposed Product Development Lifecycle"@en ;
    skos:definition "The article's proposed successor to the SDLC, blurring the distinction between developing software and developing the product itself."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:AgentsMdOpenFormatInstance a ca:AgentsMdFormat, owl:NamedIndividual ;
    rdfs:label "AGENTS.md as supported by GitLab"@en ;
    skos:definition "An open format for project instructions and context to coding agents; the article cites GitLab's support for it as an example of keeping organizational knowledge portable across models, agents and vendors."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .

cai:StripeMinionsSystemInstance a ca:MinionsAgent, owl:NamedIndividual ;
    rdfs:label "Stripe's Minions system"@en ;
    skos:definition "More than a thousand (later ~1,300) human-reviewed, agent-written pull requests merged weekly, combining deterministic blueprint nodes with agent loops in isolated devboxes."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:StripeMinionsPart1_2026"@en .

cai:SpotifyHonkSystemInstance a ca:HonkAgent, owl:NamedIndividual ;
    rdfs:label "Spotify's Honk system"@en ;
    skos:definition "Spotify's background coding agent, documented at more than 1,500 AI-generated pull requests merged into production, and reported at QCon London 2026 as achieving 1,000 merged PRs per 10 days."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:InfoQSpotifyHonk2026"@en .

cai:GitLabDuoAgentPlatformSystemInstance a ca:GitLabDuoAgentPlatform, owl:NamedIndividual ;
    rdfs:label "GitLab Duo Agent Platform (the product)"@en ;
    skos:definition "GitLab's platform for creating, customizing and operating agents around an organization's own workflows and expertise, letting customers choose underlying models and infrastructure."@en ;
    dcterms:source "code_abundance_research_v1_0_0.ttl#ca:Staples2026WhenCodeAbundant"@en .
