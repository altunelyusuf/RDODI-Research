@prefix ca: <http://example.org/rdodi/code-abundance/domain#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/rdodi/code-abundance/domain/shacl> a owl:Ontology ;
    rdfs:label "Code Abundance Domain Ontology SHACL v1.0.0"@en ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:description "Constrains code_abundance_domain_tbox_v1_17_0.ttl / _abox_v1_0_0.ttl: every class needs a label+definition+source, every NamedIndividual needs a label+definition+source linking back to Stage 1."@en ;
    dcterms:identifier "code_abundance_domain_shacl_v1_17_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-08-27"^^xsd:date ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    owl:versionIRI <http://example.org/rdodi/code-abundance/domain/shacl/1.0.0> ;
    owl:versionInfo "1.17.0" ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://example.org/rdodi/activity/CodeAbundanceRDODIRun_v1_0_0> .

ca:SubjectClassShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <http://www.w3.org/2002/07/owl#Class> .
                FILTER(STRSTARTS(STR(?this), "http://example.org/rdodi/code-abundance/domain#"))
            }
        """ ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every code-abundance domain class MUST have an rdfs:label."@en ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every code-abundance domain class MUST have a skos:definition."@en ;
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every code-abundance domain class MUST have a dcterms:source citing the Stage 1 research artifact."@en ;
    ] .

ca:ExemplarIndividualShape a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <http://www.w3.org/2002/07/owl#NamedIndividual> .
                FILTER(STRSTARTS(STR(?this), "http://example.org/rdodi/code-abundance/domain/individuals#"))
            }
        """ ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every exemplar individual MUST have an rdfs:label."@en ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every exemplar individual MUST have a skos:definition."@en ;
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every exemplar individual MUST have a dcterms:source linking back to Stage 1."@en ;
    ] .
