bl:GoalGuardStage1to3Recontent a backlog:Goal, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "This lineage never re-opens Stage 1-3 content quality"@en ;
    backlog:hasGoalStatement "An inverse goal, met by absence: no Story or Task in this backlog rewrites or re-scores Stage 1-3 research, domain, or document prose quality, beyond whatever structural sync (section count) Stage 4 conformance requires." ;
    backlog:derivesFromScope bl:CodeAbundanceScope ;
    backlog:contributesToMission bl:CodeAbundanceMission ;
