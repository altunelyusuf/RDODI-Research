bl:ObjNoSharedToolingEdits a backlog:Objective, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Zero commits touching rdodi-ecosystem/ from this session"@en ;
