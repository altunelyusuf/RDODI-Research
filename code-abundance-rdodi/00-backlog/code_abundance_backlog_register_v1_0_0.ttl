bl:ObjNoStage1to3RecontentEdits a backlog:Objective, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Zero prose-quality rewrite edits to Stage 1-3 beyond structural sync"@en ;
    backlog:hasObjectiveStatement "Count of Stories/Tasks in this backlog whose wantsCapability names rewriting or re-scoring Stage 1-3 prose quality. Currently 0 of 4 Stories: STORY-4 (Stage3-to-Stage4 section sync) touches Stage 3's structure count only, not its prose quality, which STORY-4's own soThat clause already scopes to Stage4.E/Cross.B, not content rewrite." ;
    backlog:hasSuccessMetric bl:MetricStage1to3RecontentEdits ;
    backlog:hasTargetDirection backlog:Dir_Hold ;
    backlog:hasBaselineValue "0"^^xsd:decimal ;
