bl:Evidence_TaskCleanStaticLCWKBContent a backlog:Evidence, backlog:ReleaseEvidence, owl:NamedIndividual ;
    backlog:hasReleaseVersion "1.34.0" ;
    backlog:hasPackageSHA256 "fe52ea84d7af06451a7d9c1b4a5f6ec74f6bf378c4f4549c7f648d47540d092c" ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Hardcoded LCWKB-specific content found and removed across 3 optional consts, UI-chrome text, page title, and a real functional bug"@en ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Grepped the actual instantiated output for LCWKB-specific terms and found real, systematic contamination beyond Citations: (1) COMPANY_DATA (optional field, correctly omitted from this corpus) still held the source page's own 7365-byte company-comparison dataset -- emptied to {themes:[], companies:{}}, both keys required (the first attempt, {themes:[]} alone, was checked live via Playwright and found to crash real page code -- see TASK-4's evidence); (2) SKOS_TTL (optional, 6615 bytes of the source subject's own SKOS concept scheme) -- emptied; (3) LINEAGE_TTL (documented as regenerated-from-governance, never hand-edited -- 236063 bytes of the source subject's own embedded lineage history) -- emptied rather than left wrong, since wrong lineage data is worse than none; (4) COACH_AGENT, a spec sourced from an internal document specific to the source subject with no counterpart here -- replaced with an honest 'no equivalent exists' note, not fabricated; (5) hardcoded UI-chrome: search-box placeholder text, an intent-detection regex keyed to the source subject's own framework names (a genuine functional bug -- would have failed to recognize queries about this subject's real frameworks), static prose referencing the source subject's company comparison, and the page <title> tag -- all found and replaced with content accurate to this subject. One residual 'LCWKB' occurrence remains, confirmed benign: a non-user-facing code comment." ;
    backlog:verifiedByTool "Playwright (headless Chromium)" .

bl:Evidence_TaskVerifyNoResidualSubjectContent a backlog:Evidence, backlog:ReleaseEvidence, owl:NamedIndividual ;
    backlog:hasReleaseVersion "1.34.0" ;
