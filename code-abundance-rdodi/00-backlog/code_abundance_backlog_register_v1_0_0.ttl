bl:ObjRDODIDefaultGatesPassing a backlog:Objective, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Stage4.A-K and Cross.B gates pass against the corpus-instantiated page"@en ;
    backlog:hasObjectiveStatement "The number of Stage 4 / Cross gates (per the currently-governing RDODI procedure) that pass when actually run against this package's interactive-page artifact, out of the total gates that apply to it." ;
    backlog:hasSuccessMetric bl:MetricGatePassRate ;
    backlog:hasTargetDirection backlog:Dir_Increase ;
    backlog:hasBaselineValue "0"^^xsd:decimal ;
    backlog:hasTargetValue "1"^^xsd:decimal ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:metricMovableBy bl:EpicAdoptRichDefault ;
    backlog:contributesToGoal bl:GoalStage4Conformance ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted .
    # No hasCheckpoint (G31, discipline v7.0.0): this objective's real timing
    # depends on unpredictable engineering work (when Story 1 closes), not a
    # calendar date. The shipped ObjectiveCheckpoint class supports only
    # checkpointDate, with no condition-based form -- a genuine framework
    # gap, filed as a proposal rather than minted here (L-110/B1: not this
    # session's vocabulary to extend on single-producer evidence). Not
    # required at the declared L2 level.

# ----------------------------------------------------------------------------
# Stage 5 of 5 (Backlog). Granularity: Epic (coarsest ordinary choice, per
# ceremony declaration), decomposed into Stories before planning (G3: an
# undecomposed epic may not be planned into an iteration).
# ----------------------------------------------------------------------------

bl:EpicAdoptRichDefault a backlog:Epic, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Adopt RDODI v1.3.0 default interactive-page pattern for code-abundance-rdodi"@en ;
    backlog:hasWorkItemTitle "Adopt RDODI v1.3.0 default interactive-page pattern for code-abundance-rdodi" ;
    backlog:hasIdentifier "EPIC-1" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer bl:CodeAbundanceBacklog ;
    backlog:effectiveDefinitionOfDone bl:DoDCodeAbundance ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Freshly decomposed from the Epic in this planning pass; not yet run through the framework's prioritisation method." ;
    backlog:decomposesInto bl:StoryCorpusContract, bl:StoryQuizAndGlossary, bl:StoryInstantiateAndVerify, bl:StorySyncStage4ToStage3 ;
    backlog:pursuesObjective bl:ObjRDODIDefaultGatesPassing .

bl:StoryCorpusContract a backlog:Story, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    backlog:hasIdentifier "STORY-1" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer bl:CodeAbundanceBacklog ;
    backlog:effectiveDefinitionOfDone bl:DoDCodeAbundance ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Freshly decomposed from the Epic in this planning pass; not yet run through the framework's prioritisation method." ;
    rdfs:label "Author the corpus contract"@en ;
    backlog:asRole "a reader of the interactive companion" ;
    backlog:wantsCapability "the subject's 18 concepts, 7 categories, 15 citations and their relations expressed as a corpus contract matching 01-schema/corpus_contract_v1_0_0.json" ;
    backlog:soThat "the corpus-instantiation script can build a working page from real, structured data rather than placeholders" ;
    backlog:partOf bl:EpicAdoptRichDefault ;
    backlog:pursuesObjective bl:ObjRDODIDefaultGatesPassing .

bl:StoryQuizAndGlossary a backlog:Story, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    backlog:hasIdentifier "STORY-2" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer bl:CodeAbundanceBacklog ;
    backlog:effectiveDefinitionOfDone bl:DoDCodeAbundance ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Freshly decomposed from the Epic in this planning pass; not yet run through the framework's prioritisation method." ;
    rdfs:label "Author quiz and glossary content"@en ;
    backlog:asRole "a reader checking their own understanding" ;
    backlog:wantsCapability "quiz questions and a glossary genuinely grounded in the Stage 1-3 research, not filler" ;
    backlog:soThat "the InstructionalChapterCompanion's mandatory section roles (Introduction, Body, Quiz, Glossary, References) are satisfied with real content, not stub sections" ;
    backlog:partOf bl:EpicAdoptRichDefault ;
    backlog:pursuesObjective bl:ObjRDODIDefaultGatesPassing .

bl:StoryInstantiateAndVerify a backlog:Story, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    backlog:hasIdentifier "STORY-3" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer bl:CodeAbundanceBacklog ;
    backlog:effectiveDefinitionOfDone bl:DoDCodeAbundance ;
    backlog:hasInvestmentCategory backlog:Cat_NewCapability ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Freshly decomposed from the Epic in this planning pass; not yet run through the framework's prioritisation method." ;
    rdfs:label "Instantiate the corpus and verify per the template's own reference checks"@en ;
    backlog:asRole "the package maintainer" ;
    backlog:wantsCapability "to run instantiate_corpus_v1_0_0.py against a real source page and this subject's corpus contract, then verify the result" ;
    backlog:soThat "the claim 'this page works' is checked the same way the template's own build instructions require, not asserted" ;
    backlog:partOf bl:EpicAdoptRichDefault ;
    backlog:pursuesObjective bl:ObjRDODIDefaultGatesPassing .

bl:StorySyncStage4ToStage3 a backlog:Story, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    backlog:hasIdentifier "STORY-4" ;
    backlog:hasState backlog:Proposed ;
    backlog:memberOfContainer bl:CodeAbundanceBacklog ;
    backlog:effectiveDefinitionOfDone bl:DoDCodeAbundance ;
