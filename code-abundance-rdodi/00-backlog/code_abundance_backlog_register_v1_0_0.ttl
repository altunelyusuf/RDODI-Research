    backlog:hasEstimateConfidence "High"^^xsd:string ;
    backlog:estimatedAt "2026-09-02T00:00:00Z"^^xsd:dateTime .

bl:AC_StoryShortFieldRewrite a backlog:AcceptanceCriterion, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Sidebar and menu items show short titles, not paragraph fragments"@en ;
    backlog:hasGherkinText "Given the Principle Explorer's sidebar tree and any list rendering PRINCIPLES.short, When a reader looks at any menu item, Then it reads as a short title (a few words), not a truncated sentence fragment. And When each of the 18 short values is checked programmatically, Then none exceeds 6 words." .

bl:Evidence_StoryShortFieldRewrite a backlog:Evidence, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Root cause found and fixed: short was authored as a 22-word sentence fragment, not a title"@en ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-09-02T00:00:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Direct user finding, with pasted menu-item text as evidence: sidebar/menu items were rendering as full paragraphs. Investigated the actual rendering code (renderExplorer) directly rather than assuming a template bug -- confirmed the code correctly renders only p.short, not the full p.en text. Root cause found in this session's own STORY-1 data: the short field had been built by a short_from() helper taking the first 22 words of each principle's full text, producing a run-on sentence fragment rather than a genuine short label -- confirmed programmatically (22 words per entry). This was this session's own authoring defect, not the template's. Rewrote all 18 short fields as genuine short titles (2-6 words, e.g. 'Agent Platform Pillar', 'Cost Per Accepted Change') in corpus_contract_v1_0_0.json, then patched the same 18 values directly into the live, already-cleaned HTML (rather than re-running full instantiation, which would have discarded STORY-3/6/7's cleanup work) -- confirmed exactly 18 replacements applied, matching the 18 principles exactly. Re-verified via real Playwright: 0 console/page errors, confirmed via fresh screenshot that the sidebar now shows genuinely short, scannable titles." .

