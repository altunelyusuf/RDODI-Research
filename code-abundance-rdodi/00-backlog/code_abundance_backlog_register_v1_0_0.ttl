    backlog:hasSuccessMetric bl:MetricS6ReconciliationDecisions ;
    backlog:hasTargetDirection backlog:Dir_Hold ;
    backlog:hasBaselineValue "0"^^xsd:decimal ;
    backlog:hasTargetValue "0"^^xsd:decimal ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:metricMovableBy bl:EpicAdoptRichDefault ;
    backlog:contributesToGoal bl:GoalGuardS6Reconciliation ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted .

bl:GoalGuardSharedToolingEdits a backlog:Goal, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "This lineage never edits rdodi-ecosystem's own files directly"@en ;
    backlog:hasGoalStatement "An inverse goal, met by absence: no commit from this session modifies any file under altunelyusuf/Ontologies/rdodi-ecosystem/. Findings there are proposed (00-proposals/), never applied directly (B1)." ;
    backlog:derivesFromScope bl:CodeAbundanceScope ;
    backlog:contributesToMission bl:CodeAbundanceMission ;
    backlog:decidedBy backlog:Owner ;
