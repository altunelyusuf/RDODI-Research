bl:BlueprintCodeAbundance a backlog:Blueprint, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Domain model for code-abundance-rdodi: what this product is about, not what it is for"@en ;
    backlog:blueprintFor bl:CodeAbundanceBacklog .

bl:DomainEntity_Principle a backlog:DomainEntity, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Principle -- the first-class thing this product is about: one of the 18 real, named research-corpus entries"@en .

bl:Gap_Principle_Suspension a backlog:BlueprintGap, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "No suspension/exception mechanism for a Principle"@en ;
    backlog:gapForEntity bl:DomainEntity_Principle ;
    backlog:gapForStage backlog:Stage_SuspensionException ;
    backlog:hasGapReason "Genuinely absent, not merely untracked: nothing in this product lets a principle be temporarily flagged, hidden, or marked disputed while remaining in the corpus -- a principle is either present and fully shown, or not present at all. Disclosed rather than invented a false coverage claim; would be real, separate future work if this product ever needed to mark a principle as under-review without removing it." .

bl:Gap_Principle_Termination a backlog:BlueprintGap, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "No retirement mechanism for a Principle"@en ;
    backlog:gapForEntity bl:DomainEntity_Principle ;
    backlog:gapForStage backlog:Stage_Termination ;
    backlog:hasGapReason "Genuinely absent: this product has no operation that removes a principle from the corpus once shipped -- corpus_contract.json is edited by re-authoring the whole file (STORY-1's own real process), not through any per-principle retirement path a user or process can invoke. Disclosed rather than invented a false coverage claim." .

bl:StoryBuildNoCodeBlockRemedy a backlog:Story, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    backlog:hasIdentifier "STORY-17" ;
    backlog:hasState backlog:Done ;
    backlog:finishedAt "2026-09-03T12:30:00Z"^^xsd:dateTime ;
    backlog:startedAt "2026-09-03T12:30:00Z"^^xsd:dateTime ;
    backlog:lastAuditedAt "2026-09-03T12:30:00Z"^^xsd:dateTime ;
    backlog:hasActualEffort "1"^^xsd:decimal ;
    backlog:hasApplicableConcern backlog:Concern_Interaction ;
    backlog:hasAcceptanceCriterion bl:AC_StoryBuildNoCodeBlockRemedy ;
    backlog:hasEvidence bl:Evidence_StoryBuildNoCodeBlockRemedy ;
    backlog:hasExecutionModality backlog:Mode_Automated ;
    backlog:memberOfContainer bl:CodeAbundanceBacklog ;
    backlog:effectiveDefinitionOfDone bl:DoDCodeAbundance ;
    backlog:hasCostEstimate bl:Estimate_Story17 ;
    backlog:hasInvestmentCategory backlog:Cat_TechnicalDebt ;
    backlog:pursuesObjective bl:ObjRDODIDefaultGatesPassing ;
    rdfs:label "Give the 'no code block found in response' failure a real, specific remedy"@en ;
    backlog:asRole "the pipeline's own Build/Test stage" ;
    backlog:wantsCapability "a specific, actionable remedy when a generation reply contains no fenced code block, instead of the generic fallback text" ;
    backlog:soThat "an owner-uploaded real session log showed both agentCodeGen and agentTestGen refusing twice with exactly this failure, and the raw captured model output (codelab_log.json) showed the retry attempt was not writing corrected code but paraphrasing the combined remedy text back as rambling prose -- a real, diagnosable failure this generic fallback message did nothing to correct. Root-caused directly in extractAndCheckCode: the no-code-block branch was the one flagged-result path in the whole file with no remedy field at all." .

bl:Estimate_Story17 a backlog:CostEstimate, owl:NamedIndividual ;
    rdfs:label "Cost estimate: STORY-17 (specific no-code-block remedy)"@en ;
    backlog:hasEffortEstimate "1"^^xsd:decimal ;
    backlog:hasCostBasis "Judged: a single, well-isolated code-path fix, root cause already known from the log." ;
    backlog:hasBasisKind backlog:Basis_Judged ;
    backlog:hasEstimateConfidence "High"^^xsd:string ;
    backlog:estimatedAt "2026-09-03T12:30:00Z"^^xsd:dateTime .

bl:AC_StoryBuildNoCodeBlockRemedy a backlog:AcceptanceCriterion, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "The no-code-block flag carries a specific, actionable remedy"@en ;
    backlog:hasGherkinText "Given a generation reply containing no fenced Python code block, When extractAndCheckCode processes it, Then the resulting flagged entry carries a real remedy telling the model exactly the required fence format and explicitly forbidding prose/paraphrase in its place. And Given the fix, When the real 24-question regression suite is re-run, Then all 24 still pass." ;
    backlog:satisfiedByArtifact "no code block found in response (JS string literal in code_abundance_page_v1_19_0.html's extractAndCheckCode function)" .

bl:Evidence_StoryBuildNoCodeBlockRemedy a backlog:Evidence, backlog:ReleaseEvidence, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Real fix verified via Playwright and the full regression suite"@en ;
    backlog:evidenceVerified true ;
    backlog:verifiedAt "2026-09-03T12:30:00Z"^^xsd:dateTime ;
    backlog:hasVerificationMethod "Diagnosed directly from an owner-uploaded real session log (session_log_readable.txt: both Build and Test refused 'still unsafe after 1 automatic retry: no code block found in response') and its raw captured model output (codelab_log.json: 4 real entries showing the retry attempt paraphrasing the combined remedy text as prose rather than writing code). Traced to extractAndCheckCode's own no-code-block branch, confirmed via grep to be the one flagged-result path with no remedy field. Added a specific, actionable remedy. Verified via real Playwright: extractAndCheckCode('no code here...') now returns a flagged entry with a real remedy; re-ran the full REGRESSION_QUESTIONS suite after the change, 24/24 still passing, 0 console/page errors." ;
    backlog:verifiedByTool "Playwright (headless Chromium)" ;
    backlog:attestsCriterion bl:AC_StoryBuildNoCodeBlockRemedy ;
    backlog:hasReleaseVersion "1.40.0" ;
    backlog:hasPackageSHA256 "6b663667ccbe244ba236c298ec8a6770eccfb393fe10fff4cc76fd42f0a63011" .

