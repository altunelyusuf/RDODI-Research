@prefix backlog: <http://example.org/backlog#> .
@prefix bl: <http://example.org/rdodi/code-abundance/backlog#> .
@prefix core: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
# code-abundance-rdodi BRSF lineage register
# Lineage ceremony declarations (LINEAGE_OPERATING_DISCIPLINE_v5_0_0.md):
#   Level: L2_EvidenceBound. Rationale: real, executed gate-verification
#     culture already exists (RDODI's own 4-stage pipeline); not yet at the
#     deployment/drift/measured-objective enforcement L3/L4 require.
#   Target level: L3_Governed. Review date: 2026-11-25.
#   Granularity: Epic (coarsest ordinary choice, stated as such per G1).
#   Deployment: PlanningEvent -> Iteration -> DeploymentUnit, mapped onto the
#     git-tag-per-release pattern already used for every prior publish in
#     this package.
# Stage 1 of 5 (Mission). Each stage closes in its own commit per G18.
# ============================================================================

bl:CodeAbundanceLineage a backlog:Lineage, owl:NamedIndividual ;
    rdfs:label "code-abundance-rdodi Path B lineage: Mission through Backlog"@en ;
    backlog:lineageForMission bl:CodeAbundanceMission ;
    backlog:lineageOrdinal "1"^^xsd:integer ;
    backlog:lineageArchived false .

bl:CodeAbundanceMission a backlog:Mission, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "code-abundance-rdodi package mission"@en ;
    backlog:hasMissionStatement "Produce and maintain a research companion to Staples (2026), 'When Code Is Abundant,' that is gate-verifiable at every RDODI stage, discloses rather than hides its own evidentiary limits, and keeps pace with RDODI's own evolving standard for what a Stage 4 deliverable is, rather than freezing at whatever pattern was current when the package was first built." ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasMissionOrigin backlog:Origin_SessionDrafted ;
    backlog:missionFor bl:CodeAbundanceBacklog .

bl:StageOutput_Mission a backlog:StageOutput, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Stage 1 (Mission) output"@en ;
    backlog:outputOfStage backlog:Stage_Mission ;
    backlog:hasStateDigest "d24c7567c48c36b556305314a4171d2eec2911436a2fcffc5f8fdc71172ffa75" ;
    backlog:closedAtCommit "143dff605d2889b3ca35050925cbae78b099cf01" .

# ----------------------------------------------------------------------------
# Stage 2 of 5 (Scope). Deliverables enumerated clause-by-clause from the
# Mission statement, per G17 -- each states what must be true, not what
# someone will do.
# ----------------------------------------------------------------------------

bl:AreaAllStagesGateCleanliness a backlog:ScopeArea, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "All four RDODI stage artifacts (01-research/, 02-domain/, 03-document/, 04-interactive-page/)"@en ;
    skos:definition "The full set of code-abundance-rdodi's RDODI-governed artifacts across all four pipeline stages, tested against the mission's own 'gate-verifiable at every RDODI stage' clause per G28 (the RDODI Four-Stage Pipeline Procedure v1.3.0 is the external taxonomy this area is derived from, not paraphrase)."@en ;
    backlog:areaLocation "code-abundance-rdodi/{01-research,02-domain,03-document,04-interactive-page}/" ;
    backlog:areaMeasure "18 of 18 mechanically-checked gates pass (Stage1.A/B, Stage2.A/C, Stage3.A/B/E.cov/E.sub/src, Stage4.A/B/cov/sub/src, Cross.B, 3 widget gates), re-run 2026-08-27. Stage4.E (section-count sync, 21 vs 25) is separately, manually known non-conformant pending Story-4." ;
    backlog:hasScopeLayer backlog:Layer_Product .

bl:AreaDisclosedLimits a backlog:ScopeArea, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Disclosed evidentiary limits across Research, Document, and Interactive-Page (not Domain)"@en ;
    skos:definition "Where this package's disclosed limitations actually live, tested per G28 against the RDODI stage taxonomy: the Amplitude citation-verification gap in Stage 1's quality scorecard, the GitLab conflict-of-interest note in Stage 3's sections, and their preservation in whatever Stage 4 artifact exists. Stage 2 (Domain) is out: a taxonomy carries no evidentiary prose to disclose or hide."@en ;
    backlog:areaLocation "code-abundance-rdodi/01-research/, code-abundance-rdodi/03-document/, code-abundance-rdodi/04-interactive-page/" ;
    backlog:areaMeasure "2 named, disclosed limitations tracked: the Amplitude PR-cycle-time/bug-count figures (flagged unavailable, Stage 1 quality scorecard), and GitLab's own commercial stake in the Agent Platform pillar (Stage 3, GitLab Duo Agent Platform section). Both present and unweakened as of v1.2.0/v1.1.0." ;
    backlog:hasScopeLayer backlog:Layer_Product .

bl:AreaStage4Artifact a backlog:ScopeArea, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "The code-abundance-rdodi Stage 4 artifact (04-interactive-page/)"@en ;
    skos:definition "The interactive-page HTML and its page ABox under code-abundance-rdodi/04-interactive-page/, whatever pattern the currently-governing RDODI procedure specifies for it."@en ;
    backlog:areaLocation "code-abundance-rdodi/04-interactive-page/" ;
    backlog:areaMeasure "2 files (code_abundance_page_v1_1_0.html, code_abundance_page_abox_v1_1_0.ttl), built for RDODI procedure v1.2.2's single-flowing-page default; 0 files yet built for the current v1.3.0 default." ;
    backlog:hasScopeLayer backlog:Layer_Product .

bl:CodeAbundanceScope a backlog:ScopeStatement, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    backlog:coversArea bl:AreaAllStagesGateCleanliness, bl:AreaDisclosedLimits, bl:AreaStage4Artifact ;
    rdfs:label "code-abundance-rdodi Path B scope"@en ;
    backlog:hasScopeText "Bring code-abundance-rdodi's Stage 4 deliverable into conformance with whichever RDODI Stage 4 pattern the currently-governing procedure specifies (as of this lineage: the rich sidebar/tabs/chat default, per procedure v1.3.0), while keeping Stages 1-3 gate-clean and every prior evidentiary disclosure intact." ;
    backlog:requiresDeliverable bl:Deliverable_AllStagesGateClean, bl:Deliverable_DisclosedLimitsPreserved, bl:Deliverable_Stage4ConformsToCurrentDefault ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:scopeRealizesObjective bl:ObjRDODIDefaultGatesPassing ;
    backlog:scopeForMission bl:CodeAbundanceMission ;
    backlog:hasScopeExclusion bl:Exclusion_S6Reconciliation, bl:Exclusion_SharedToolingEdits, bl:Exclusion_Stage1to3Recontent .

bl:Deliverable_AllStagesGateClean a backlog:ScopeDeliverable, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "All four RDODI stages pass their gates at the version this lineage ships"@en ;
    backlog:deliverableStatement "Research, domain, document, and interactive-page artifacts each pass every gate defined for their stage in the currently-governing RDODI procedure, re-run and verified, not asserted."@en ;
    backlog:derivesFromMissionClause "gate-verifiable at every RDODI stage" ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:deliverableForArea bl:AreaAllStagesGateCleanliness .

bl:Deliverable_DisclosedLimitsPreserved a backlog:ScopeDeliverable, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Every previously-disclosed evidentiary limit remains visible in the new artifact"@en ;
    backlog:deliverableStatement "The Amplitude citation-verification gap, the GitLab-conflict-of-interest note, and every other disclosed limitation already recorded in Stage 1-3 remain visible and unweakened in whatever Stage 4 artifact this lineage produces."@en ;
    backlog:derivesFromMissionClause "discloses rather than hides its own evidentiary limits" ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:deliverableForArea bl:AreaDisclosedLimits .

bl:Deliverable_Stage4ConformsToCurrentDefault a backlog:ScopeDeliverable, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Stage 4 artifact instantiates the corpus-template default pattern"@en ;
    backlog:deliverableStatement "A working HTML page produced via 08-brsf-corpus-template's instantiate_corpus_v1_0_0.py against a real corpus contract for this subject, verified per that mechanism's own five reference checks (renders; old corpus fully gone; 11 agents intact; SHACL >100KB present; zero page errors)."@en ;
    backlog:derivesFromMissionClause "keeps pace with RDODI's own evolving standard for what a Stage 4 deliverable is" ;
    backlog:hasScopeLayer backlog:Layer_Product ;
    backlog:deliverableForArea bl:AreaStage4Artifact .

bl:Exclusion_S6Reconciliation a backlog:ScopeExclusion, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Reconciling the native S6 generator with the corpus-instantiation approach"@en ;
    backlog:excludesConcern "Reconciling 06-s6-exemplar/ with 08-brsf-corpus-template/ as alternate Stage 4 mechanisms." ;
    backlog:hasExclusionRationale "Named by the ecosystem itself as an open question, unchanged across multiple releases (28-interactive-html-surface/README_v1_1_0.md). Not this package's decision to make; out of scope for this lineage." ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasScopeLayer backlog:Layer_Work .

bl:Exclusion_SharedToolingEdits a backlog:ScopeExclusion, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Modifying rdodi-ecosystem's own shared tooling or vocabulary"@en ;
    backlog:excludesConcern "Direct edits to any file under altunelyusuf/Ontologies/rdodi-ecosystem/." ;
    backlog:hasExclusionRationale "B1 boundary: rdodi-ecosystem is owned by another session lineage. This package proposes findings (00-proposals/), it does not edit that package's files directly." ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasScopeLayer backlog:Layer_Work .

bl:Exclusion_Stage1to3Recontent a backlog:ScopeExclusion, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Re-opening Stage 1-3 content quality"@en ;
    backlog:excludesConcern "Rewriting or re-scoring Stage 1-3 research, domain, or document prose quality." ;
    backlog:hasExclusionRationale "Stage 1-3 content quality was already addressed in v1.2.0 (academic/industrial depth rewrite) and is not the subject of this lineage. This lineage touches Stage 4 only, plus whatever Stage 3 structural sync (section count) Stage 4 conformance requires." ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasScopeLayer backlog:Layer_Work .

# ----------------------------------------------------------------------------
# Stage 3 of 5 (Goal). Derived from the scope, not attached to the mission
# directly (G13) -- carries both derivesFromScope and contributesToMission.
# ----------------------------------------------------------------------------

bl:GoalStage4Conformance a backlog:Goal, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Every declared scope area reaches its finish condition"@en ;
    backlog:hasGoalStatement "All three scope areas -- all-stages gate cleanliness, disclosed-limits preservation, and Stage 4 conformance to the currently-governing RDODI default -- reach their finish condition, not only the easiest of the three. (Individual IRI retained from this goal's original narrower scope; widened per G29 rather than renamed, since it is the same standing scope-facing obligation, now correctly covering the full scope after the G28 area review.)" ;
    backlog:derivesFromScope bl:CodeAbundanceScope ;
    backlog:contributesToMission bl:CodeAbundanceMission ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:hasGoalFacing backlog:Facing_Scope ;
    backlog:goalCoversArea bl:AreaAllStagesGateCleanliness, bl:AreaDisclosedLimits, bl:AreaStage4Artifact .

# ----------------------------------------------------------------------------
# Stage 4 of 5 (Objective). Carries a real baseline/target per G4 -- an
# objective without a metric cannot be missed and constrains no decision.
# ----------------------------------------------------------------------------

bl:MetricGatePassRate a core:Metric, owl:NamedIndividual ;
    rdfs:label "Applicable Stage4/Cross gate pass rate"@en .

bl:MetricOutOfAreaWork a core:Metric, owl:NamedIndividual ;
    rdfs:label "Work items pursuing something outside a declared Area"@en .

bl:MetricS6ReconciliationDecisions a core:Metric, owl:NamedIndividual ;
    rdfs:label "S6/corpus-template reconciliation decisions made by this session"@en .

bl:MetricSharedToolingEdits a core:Metric, owl:NamedIndividual ;
    rdfs:label "Commits by this session touching altunelyusuf/Ontologies/rdodi-ecosystem/"@en .

bl:MetricStage1to3RecontentEdits a core:Metric, owl:NamedIndividual ;
    rdfs:label "Prose-quality rewrite edits to Stage 1-3 beyond what Stage 4 conformance structurally requires"@en .

bl:GoalContainment a backlog:Goal, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "No work happens outside the three declared scope areas"@en ;
    backlog:hasGoalStatement "Every work item in this backlog pursues something that traces to AreaAllStagesGateCleanliness, AreaDisclosedLimits, or AreaStage4Artifact. Without this, the lineage could reach its mission and its scope while spending effort nobody asked for, invisible to any measure that only counts what was required." ;
    backlog:derivesFromScope bl:CodeAbundanceScope ;
    backlog:contributesToMission bl:CodeAbundanceMission ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:hasGoalFacing backlog:Facing_Containment ;
    backlog:goalCoversArea bl:AreaAllStagesGateCleanliness, bl:AreaDisclosedLimits, bl:AreaStage4Artifact .

bl:ObjNoOutOfAreaWork a backlog:Objective, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Zero work items pursuing something outside a declared Area"@en ;
    backlog:hasObjectiveStatement "Count of work items in this backlog (Epic, Stories) whose pursuesObjective chain does not trace to a declared ScopeArea via a Deliverable or the Goal. Currently 0 by direct check: all 5 work items pursue ObjRDODIDefaultGatesPassing, which the widened GoalStage4Conformance covers across all 3 areas." ;
    backlog:hasSuccessMetric bl:MetricOutOfAreaWork ;
    backlog:hasTargetDirection backlog:Dir_Hold ;
    backlog:hasBaselineValue "0"^^xsd:decimal ;
    backlog:hasTargetValue "0"^^xsd:decimal ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:metricMovableBy bl:EpicAdoptRichDefault ;
    backlog:contributesToGoal bl:GoalContainment ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted .

bl:GoalGuardS6Reconciliation a backlog:Goal, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "This lineage never decides the S6/corpus-template reconciliation question"@en ;
    backlog:hasGoalStatement "An inverse goal, met by absence: no work item in this backlog resolves whether 06-s6-exemplar/ or 08-brsf-corpus-template/ is RDODI's canonical Stage 4 mechanism. That question is named by the ecosystem itself as open and unowned by this session." ;
    backlog:derivesFromScope bl:CodeAbundanceScope ;
    backlog:contributesToMission bl:CodeAbundanceMission ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:hasGoalFacing backlog:Facing_Exclusion ;
    backlog:guardsExclusion bl:Exclusion_S6Reconciliation .

bl:ObjNoS6ReconciliationDecisions a backlog:Objective, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Zero S6/corpus-template reconciliation decisions made"@en ;
