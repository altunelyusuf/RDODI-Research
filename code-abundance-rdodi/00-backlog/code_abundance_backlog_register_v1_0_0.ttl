# ----------------------------------------------------------------------------
# Adoption profile -- declares the conformance level the SHACL suite must
# enforce. Not one of the pipeline's tracked stage types, so appending this
# does not disturb any StageOutput digest already closed and verified.
# ----------------------------------------------------------------------------

bl:DoDCriterionGatesPass a backlog:DoDCriterion, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "Applicable RDODI stage gates pass"@en ;
    backlog:hasCheckQuery "Re-run every gate the currently-governing RDODI procedure defines for the stage(s) touched; verdict PASS for all of them." ;
    backlog:hasExpectedResult "PASS on every applicable gate." ;
    backlog:hasCriterionStatus backlog:NotYetEnforceable .

bl:DoDCodeAbundance a backlog:DefinitionOfDone, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "code-abundance-rdodi Definition of Done"@en ;
    backlog:hasDoDCriterion bl:DoDCriterionGatesPass .

bl:CommitmentCodeAbundance a backlog:Commitment, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "code-abundance-rdodi backlog commitment"@en ;
    backlog:commitsToGoal bl:GoalStage4Conformance ;
    backlog:commitsToDefinitionOfDone bl:DoDCodeAbundance .

bl:CodeAbundanceBacklog a backlog:Backlog, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "code-abundance-rdodi backlog"@en ;
    backlog:hasIdentifier "code-abundance-rdodi-backlog" ;
    backlog:hasScopeStatement bl:CodeAbundanceScope ;
    backlog:hasMember bl:EpicAdoptRichDefault ;
    backlog:hasCommitment bl:CommitmentCodeAbundance ;
    backlog:appliesDefinitionOfDone bl:DoDCodeAbundance .

bl:CodeAbundanceAdoptionProfile a backlog:AdoptionProfile, owl:NamedIndividual ;
    backlog:belongsToLineage bl:CodeAbundanceLineage ;
    rdfs:label "code-abundance-rdodi BRSF adoption profile"@en ;
    backlog:governsBacklog bl:CodeAbundanceBacklog ;
    backlog:adoptsFacet backlog:CoreFacet, backlog:EvidenceFacet, backlog:InvariantFacet, backlog:AuditFacet ;
    backlog:hasConformanceLevel backlog:L2_EvidenceBound ;
    backlog:hasTargetConformanceLevel backlog:L3_Governed ;
    backlog:hasLevelReviewDate "2026-11-25T00:00:00"^^xsd:dateTime ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasDecisionRationale "Real, executed gate-verification culture already exists in this package (RDODI's own 4-stage pipeline, re-run and re-verified at every version); not yet at the deployment/drift/measured-objective enforcement L3/L4 require. L1 would understate what already holds: Done items in this package's history have carried verified evidence throughout, which is exactly L2's bar. Test-driven against L3_Governed on 2026-08-27 per G11: 0 violations on a scratch copy declaring L3, closed from an initial 25. Not promoted to L3 on that result alone -- with zero WorkItems yet Done, L3's Done-anchored checks (deployment verification, per-item re-verification, executable cross-cutting invariants) are vacuously satisfied rather than genuinely exercised, per G4 (completion is not accomplishment). Promotion is deferred until at least one Story completes a full cycle and L3 is re-tested against real Done/evidence content, not an empty backlog."^^xsd:string .
