# ----------------------------------------------------------------------------
# New in v1.1.0: citation-verification status bar (a second, distinct widget
# primitive -- a data visualization, not a click-to-reveal toggle -- added
# for genuine visual/interaction density per the ecosystem's own documented
# floor rule (RDODI_interactive_page_standard_analysis_v1_0_0.md SS3).
# ----------------------------------------------------------------------------

ca:CitationVerificationStatusBar a wp:WidgetPrimitive, owl:NamedIndividual ;
    rdfs:label "Citation Verification Status Bar"@en ;
    skos:definition "A segmented horizontal bar visualizing how many of the report's 15 concept exemplars were independently verified, partially verified, or flagged unavailable. Data-driven from the Stage 1 research artifact's own quality scorecard, not decorative."@en ;
    dcterms:source "Authored for code-abundance-rdodi Stage 4, v1.1.0; a package-scoped widget primitive."@en .

cai:Widget_CitationVerificationStatus a ipo:InstructionalWidget, owl:NamedIndividual ;
    rdfs:label "Citation verification status bar"@en ;
    skos:definition "Renders the count of verified (13), partially verified (1) and unavailable (1) citations among the report's 15 concept exemplars, sourced from the Stage 1 quality scorecard."@en ;
    wp:instantiatesPrimitive ca:CitationVerificationStatusBar ;
    ds:selectionWarrant "The Stage 1 quality scorecard discloses a specific, countable verification breakdown across citations -- warrants a data visualization rather than prose restatement."@en ;
    wp:demonstratesConcept ca:IndustryImplementation ;
    ipo:demonstratesSubject ca:IndustryImplementation ;
    dcterms:source cad:Sec_IndustryImplementation ;
    wp:designTestPassed true ;
    dcterms:identifier "status-bar-industryimplementation" .
