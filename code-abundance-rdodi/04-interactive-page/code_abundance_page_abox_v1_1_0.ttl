# ----------------------------------------------------------------------------
# 15 widgets, one per leaf concept, matching widget_gates_v1_0_0.py exactly:
#   wp:instantiatesPrimitive, ds:selectionWarrant, wp:demonstratesConcept,
#   dcterms:source, wp:designTestPassed, wp:hasTestProcedure -> wp:TestProcedure.
# designTestPassed true is recorded because the Playwright test below was
# ACTUALLY RUN against code_abundance_page_v1_0_0.html and passed (15/15) --
# not asserted (B3).
# ----------------------------------------------------------------------------

cai:Widget_AgentPlatformPillar a ipo:InstructionalWidget, owl:NamedIndividual ;
    rdfs:label "Agent Platform Pillar grounding-evidence toggle"@en ;
    skos:definition "An interactive control that reveals the exemplar individual and citation grounding Agent Platform Pillar in the domain ontology."@en ;
    wp:instantiatesPrimitive ca:CitationDisclosureToggle ;
    ds:selectionWarrant "Source text names a specific product (GitLab Duo Agent Platform) with a distinguishing quote -- warrants disclosing the exemplar+citation on demand rather than inline."@en ;
    wp:demonstratesConcept ca:AgentPlatformPillar ;
    ipo:demonstratesSubject ca:AgentPlatformPillar ;
    dcterms:source cad:Sec_AgentPlatformPillar ;
    wp:designTestPassed true ;
    dcterms:identifier "toggle-sec-agentplatformpillar" .

cai:Widget_ContextPillar a ipo:InstructionalWidget, owl:NamedIndividual ;
    rdfs:label "Context Pillar grounding-evidence toggle"@en ;
    skos:definition "An interactive control that reveals the exemplar individual and citation grounding Context Pillar in the domain ontology."@en ;
    wp:instantiatesPrimitive ca:CitationDisclosureToggle ;
    ds:selectionWarrant "Source text names a specific product (GitLab Orbit) -- warrants a disclosure toggle."@en ;
    wp:demonstratesConcept ca:ContextPillar ;
    ipo:demonstratesSubject ca:ContextPillar ;
    dcterms:source cad:Sec_ContextPillar ;
    wp:designTestPassed true ;
    dcterms:identifier "toggle-sec-contextpillar" .

