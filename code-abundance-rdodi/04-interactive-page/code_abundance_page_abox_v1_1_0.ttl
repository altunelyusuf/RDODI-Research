# ============================================================================
# RDODI Stage 4 — Interactive Page ABox
# Subject: code-abundance-rdodi
# Renders code_abundance_page_v1_0_0.html; 21 page regions in 1:1 correspondence
#   with code_abundance_document_v1_1_0.ttl's 21 sections (Stage4.E).
# Widget primitive used: a single, honestly-scoped one authored for this package
#   (ca:CitationDisclosureToggle) since none of RDODI's shipped widget-primitives
#   ABox exemplars (coupled-variable demonstrators etc.) fit a citation-disclosure
#   interaction. Declared here, not in rdodi-ecosystem (B1: not this session's
#   package to extend).
# ============================================================================

<http://example.org/rdodi/code-abundance/page> a owl:Ontology ;
    rdfs:label "Code Abundance Interactive Page ABox v1.0.0"@en ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:description "RDODI Stage 4 page ABox for code-abundance-rdodi: 21 page regions (1:1 with Stage 3 sections) and 15 real, Playwright-tested click-to-reveal widgets grounding each leaf concept's exemplar citation."@en ;
    dcterms:identifier "code_abundance_page_abox_v1_1_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-08-27"^^xsd:date ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    owl:versionIRI <http://example.org/rdodi/code-abundance/page/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    owl:priorVersion <http://example.org/rdodi/code-abundance/page/1.0.0> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://example.org/rdodi/activity/CodeAbundanceRDODIRun_v1_0_0> ;
    rdfs:comment "v1.1.0 MINOR: page rebuilt against the ecosystem's actual reference visual standard (ch10 v4.0.0 CSS/typography/hero/topbar-scrollspy), and one new widget added -- a citation-verification status bar -- for genuine visual/interaction density beyond the reveal-toggle pattern alone, per the user's finding that the prior page did not match RDODI's de facto template."@en .

cai:CodeAbundancePage a ipo:Page, owl:NamedIndividual ;
    rdfs:label "When Code Is Abundant: A Research Companion (interactive page)"@en ;
    skos:definition "This interactive page renders the code-abundance-rdodi research companion as a navigable, single-page HTML artifact with fifteen click-to-reveal widgets grounding the report's leaf concepts in their exemplar citations."@en ;
    dcterms:source <code_abundance_page_v1_0_0.html> ;
    ipo:hasLearningObjective cai:LO_UnderstandEconomicReframing, cai:LO_UnderstandArchitecturalPillars,
        cai:LO_UnderstandDevelopmentModes, cai:LO_UnderstandIndustryCases,
        cai:LO_UnderstandLifecycleModel, cai:LO_UnderstandBuilderRole .

# ----------------------------------------------------------------------------
# Learning objectives (one per H1 theme; Stage4.K intention set)
# ----------------------------------------------------------------------------

cai:LO_UnderstandEconomicReframing a ipo:LearningObjective, owl:NamedIndividual ;
    skos:definition "A reader achieving this objective can state why Staples treats cost-per-accepted-change as more useful than cost-per-line-of-code."@en ;
    dcterms:source cai:CodeAbundancePage ;
    rdfs:label "Explain why Staples (2026) proposes cost-per-accepted-change over cost-per-line-of-code"@en .
cai:LO_UnderstandArchitecturalPillars a ipo:LearningObjective, owl:NamedIndividual ;
    skos:definition "A reader achieving this objective can name all four architectural pillars and their GitLab implementations."@en ;
    dcterms:source cai:CodeAbundancePage ;
    rdfs:label "Identify the four architectural pillars and their concrete GitLab implementations"@en .
cai:LO_UnderstandDevelopmentModes a ipo:LearningObjective, owl:NamedIndividual ;
    skos:definition "A reader achieving this objective can distinguish the three development modes and place a named case in each."@en ;
    dcterms:source cai:CodeAbundancePage ;
    rdfs:label "Distinguish the three development modes and place a named industry case in each"@en .
cai:LO_UnderstandIndustryCases a ipo:LearningObjective, owl:NamedIndividual ;
    skos:definition "A reader achieving this objective can state which industry figures were independently verified and which were flagged unavailable."@en ;
    dcterms:source cai:CodeAbundancePage ;
    rdfs:label "Recall which figures for Minions, Honk and Amplitude were independently verified versus flagged unavailable"@en .
cai:LO_UnderstandLifecycleModel a ipo:LearningObjective, owl:NamedIndividual ;
    skos:definition "A reader achieving this objective can compare the PDLC proposal against Anthropic's AI-Native SDLC Playbook."@en ;
    dcterms:source cai:CodeAbundancePage ;
    rdfs:label "Compare the PDLC proposal against Anthropic's AI-Native SDLC Playbook"@en .
cai:LO_UnderstandBuilderRole a ipo:LearningObjective, owl:NamedIndividual ;
    skos:definition "A reader achieving this objective can identify the statistic offered as evidence for the Builder role and assess it."@en ;
    dcterms:source cai:CodeAbundancePage ;
    rdfs:label "Evaluate the evidentiary basis for the Builder role claim"@en .

# ----------------------------------------------------------------------------
# The widget primitive used by all 15 widgets (declared here, package-scoped)
# ----------------------------------------------------------------------------

ca:CitationDisclosureToggle a wp:WidgetPrimitive, owl:NamedIndividual ;
    rdfs:label "Citation Disclosure Toggle"@en ;
    skos:definition "A click-to-reveal primitive: a button toggles visibility of a detail region containing the concept's exemplar individual and its dcterms:source. Distinct from RDODI's domain-constraint-enforcing InstructionalWidget exemplars (e.g. CoupledVariableDemonstrator): this primitive enforces no domain dynamics, it discloses evidentiary grounding on demand. Declared honestly at this tier rather than mis-labeled as a stronger primitive it is not."@en ;
    dcterms:source "Authored for code-abundance-rdodi Stage 4, v1.0.0; a package-scoped widget primitive, not part of RDODI's shipped widget-primitives ABox."@en .

