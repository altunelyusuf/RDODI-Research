# ============================================================================
# RDODI Stage 4 -- Interactive Page ABox (Path B: corpus-instantiated pattern)
# Subject: code-abundance-rdodi
# Renders code_abundance_page_v1_16_0.html. 18 sections, one per real Stage 2
#   leaf concept (not 25 -- CATEGORIES group but are not individually navigable
#   sections; the 18 PRINCIPLES are the real, addressable units, confirmed via
#   selectPrinciple(id) navigation, live-tested).
# Widget primitive: ca:PrincipleDetailNavigator, a genuinely different primitive
#   from the old pattern's CitationDisclosureToggle -- confirmed live via
#   Playwright: clicking a principle renders its real framework citations and
#   typed relation chips, each independently clickable/navigable, not a single
#   reveal-toggle. Declared here, not in rdodi-ecosystem (B1).
# ============================================================================

<http://example.org/rdodi/code-abundance/page> a owl:Ontology ;
    rdfs:label "Code Abundance Interactive Page ABox v1.3.0"@en ;
    dcterms:created "2026-09-01"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:description "RDODI Stage 4 page ABox for code-abundance-rdodi Path B: 18 sections (1:1 with the 18 real Stage 2 leaf concepts) and 18 real, Playwright-tested per-concept detail-navigation widgets, each grounding its concept in real framework citations and typed relation chips."@en ;
    dcterms:identifier "code_abundance_page_abox_v1_16_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-01"^^xsd:date ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    owl:versionIRI <http://example.org/rdodi/code-abundance/page/1.3.0> ;
    owl:versionInfo "1.16.0" ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    rdfs:comment "First ABox for the Path B corpus-instantiated pattern. The old pattern's v1.1.0 ABox (99-retired/) used per-section click-to-reveal citation widgets; this pattern's real interactivity is structurally different (chat console, relation graph, principle browsing), so the widget-intention mapping was rebuilt from what the real page actually does, not force-fit onto the old shape -- confirmed live via Playwright before any triple was written."@en .

cai:CodeAbundancePage a ipo:Page, owl:NamedIndividual ;
    rdfs:label "When Code Is Abundant: A Research Companion (interactive page, Path B)"@en ;
    skos:definition "This interactive page renders the code-abundance-rdodi research companion as a corpus-instantiated artifact: a hierarchical principle explorer, a grounded chat console, and a citations tab, with eighteen per-concept detail-navigation widgets."@en ;
    dcterms:source <code_abundance_page_v1_16_0.html> .

# ----------------------------------------------------------------------------
# Widget primitive
# ----------------------------------------------------------------------------

ca:PrincipleDetailNavigator a wp:WidgetPrimitive, owl:NamedIndividual ;
    rdfs:label "Principle Detail Navigator"@en ;
    skos:definition "A per-concept detail-rendering primitive: selecting a concept renders its category, its real cited frameworks as independently clickable citation links, and its real typed relations as independently clickable navigation chips to the related concept. Distinct from the old pattern's CitationDisclosureToggle (a single reveal/hide toggle): this primitive is multi-element and multi-hop -- verified live via Playwright, not assumed from the corpus contract."@en ;
    dcterms:source "Authored for code-abundance-rdodi Stage 4 Path B, v1.3.0; a package-scoped widget primitive, not part of RDODI's shipped widget-primitives ABox."@en .

